# ============================================================
# DEVTech — environment template
# ============================================================
# Copy this file to `.env` and fill in the values.
#
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# The real `.env` is gitignored; this template is committed so that
# anyone who clones the repo knows which variables the app reads
# and what shape each one expects.
#
# NEVER put a real secret in this file. It is committed.
# ============================================================


# ---- Flask ----
# development | production | testing
FLASK_ENV=development

# Secret key for session signing and CSRF.
# Generate a fresh one for every environment that isn't your laptop:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Host the dev server binds to when running `python app.py`.
# Leave as 127.0.0.1 unless you know you need otherwise.
DEV_HOST=127.0.0.1

# Set to 1 to run the dev server with a self-signed HTTPS certificate.
# Only needed locally when testing Google/Facebook OAuth callbacks.
#   0 = plain HTTP (default)
#   1 = self-signed HTTPS
DEV_SSL=0


# ---- Database ----
# Format: mysql+pymysql://USER:PASSWORD@HOST/DATABASE
# For a local MySQL install with default credentials:
DATABASE_URL=mysql+pymysql://root:password@localhost/devtech_db
#
# Examples for other setups:
#   mysql+pymysql://devtech_user:secret@127.0.0.1:3306/devtech_db
#   mysql+pymysql://user:pass@db.example.com/devtech_db?charset=utf8mb4


# ---- OAuth (optional) ----
# Leave blank to disable social login. When blank, the "Sign in with
# Google/Facebook" buttons on the login page are hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=


# ---- Rate limiting ----
# Storage backend for Flask-Limiter.
#   memory://            single-process dev only; resets on restart
#   redis://host:port/db persistent; required for multi-worker prod
RATELIMIT_STORAGE_URI=memory://


# ---- Caching ----
# CACHE_TYPE options: SimpleCache | FileSystemCache | RedisCache
# SimpleCache is in-process; each gunicorn worker gets its own cache.
# RedisCache shares across workers — required for anything non-toy.
CACHE_TYPE=SimpleCache
CACHE_REDIS_URL=


# ---- First-admin setup token ----
# Used only by the /setup/first-admin route. That route returns 404 the
# moment any admin exists in the database, so this value only matters
# on a brand-new install.
#
# Leave blank if you plan to create the first admin via the CLI:
#   flask --app app create-admin
#
# Generate one if you'd rather bootstrap through the browser:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SETUP_TOKEN=